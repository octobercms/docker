# October Docker .gitignore

# User container configurations (contain site-specific settings)
containers/*.yml
!containers/*.yml.example
!containers/.gitkeep

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~

# Log files
*.log

# Temporary files
tmp/
temp/

# OS files
.DS_Store
Thumbs.db

# Docker build artifacts
*.tar
*.tar.gz
