#!/usr/bin/env bash
#
# October Docker Health Check Tool
#
# Diagnoses common issues with October CMS Docker containers
# No host dependencies beyond Bash and Docker
#

set -e

# Configuration
VERSION="1.0.0"
DEFAULT_IMAGE="octobercms/base:1.0"

# Paths (relative to script location)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONTAINERS_DIR="$SCRIPT_DIR/containers"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# Issue tracking
declare -a ISSUES
declare -a WARNINGS

##############################################################################
# Helper Functions
##############################################################################

info() {
    echo -e "${CYAN}INFO:${NC} $1"
}

success() {
    echo -e "${GREEN}$1${NC}"
}

warning() {
    echo -e "${YELLOW}$1${NC}"
}

error() {
    echo -e "${RED}$1${NC}"
}

cyan() {
    echo -e "${CYAN}$1${NC}"
}

pass() {
    echo -e "${GREEN}OK${NC} - $1"
}

warn() {
    echo -e "${YELLOW}WARN${NC} - $1"
    WARNINGS+=("$1")
}

fail() {
    echo -e "${RED}FAIL${NC} - $1"
    ISSUES+=("$1")
}

skip() {
    echo -e "${CYAN}SKIP${NC} - $1"
}

##############################################################################
# Docker Detection
##############################################################################

check_docker() {
    if ! command -v docker &> /dev/null; then
        error "Docker not found. Please install Docker first."
        exit 1
    fi

    if ! docker info &> /dev/null; then
        error "Docker daemon is not running. Please start Docker."
        exit 1
    fi
}

# Get docker path - quote it to handle spaces in Windows paths
docker_path="$(which docker 2>/dev/null || echo "/usr/bin/docker")"

##############################################################################
# Container Helpers
##############################################################################

container_exists() {
    local name="$1"
    "$docker_path" ps -a --format '{{.Names}}' 2>/dev/null | grep -q "^${name}$"
}

container_running() {
    local name="$1"
    "$docker_path" ps --format '{{.Names}}' 2>/dev/null | grep -q "^${name}$"
}

exec_in_container() {
    local container="$1"
    local user="${2:-root}"
    shift 2
    local cmd="$@"

    "$docker_path" exec -u "$user" "$container" bash -c "$cmd" 2>/dev/null
}

get_docker_version() {
    "$docker_path" version --format '{{.Server.Version}}' 2>/dev/null || echo "unknown"
}

##############################################################################
# Utility Functions
##############################################################################

format_uptime() {
    local seconds="$1"

    if [[ $seconds -lt 60 ]]; then
        echo "${seconds}s"
    elif [[ $seconds -lt 3600 ]]; then
        echo "$((seconds / 60))m"
    elif [[ $seconds -lt 86400 ]]; then
        echo "$((seconds / 3600))h"
    else
        echo "$((seconds / 86400))d"
    fi
}

##############################################################################
# Health Checks
##############################################################################

show_header() {
    echo ""
    cyan "╔══════════════════════════════════════════════════════════╗"
    cyan "║                                                          ║"
    cyan "║               October Docker Health Check                ║"
    cyan "║                                                          ║"
    cyan "╚══════════════════════════════════════════════════════════╝"
    echo ""
    info "Checking container: $CONTAINER_NAME"
    echo ""
}

check_docker_status() {
    echo -n "  Docker: "

    if ! "$docker_path" info &> /dev/null; then
        fail "Docker is not running"
        return
    fi

    local version=$(get_docker_version)
    pass "Docker running (v$version)"
}

check_container_status() {
    echo -n "  Container Status: "

    if ! container_running "$CONTAINER_NAME"; then
        fail "Container is not running"
        return
    fi

    # Get container uptime
    local uptime_output=$(exec_in_container "$CONTAINER_NAME" "root" "cat /proc/uptime 2>/dev/null")

    if [[ -n "$uptime_output" ]]; then
        local uptime_seconds=${uptime_output%%.*}
        local uptime_str=$(format_uptime "$uptime_seconds")
        pass "Container running (uptime: $uptime_str)"
    else
        pass "Container running"
    fi
}

check_database() {
    echo -n "  Database: "

    # Check if MySQL is running locally
    local mysql_ping=$(exec_in_container "$CONTAINER_NAME" "root" "mariadb-admin ping --silent 2>/dev/null")

    if [[ "$mysql_ping" == *"alive"* ]]; then
        # Check database connection from Laravel
        local db_check=$(exec_in_container "$CONTAINER_NAME" "october" "cd /var/www/october && php artisan db:show 2>&1 | head -3")

        if [[ "$db_check" == *"Connection"* ]] || [[ "$db_check" == *"MariaDB"* ]] || [[ "$db_check" == *"MySQL"* ]]; then
            pass "MySQL connected"
        else
            warn "MySQL running but application cannot connect"
        fi
    else
        # Check if using external database
        local db_check=$(exec_in_container "$CONTAINER_NAME" "october" "cd /var/www/october && php artisan db:show 2>&1 | head -3")

        if [[ "$db_check" == *"Connection"* ]] || [[ "$db_check" == *"MySQL"* ]]; then
            pass "External database connected"
        else
            fail "Database connection failed"
        fi
    fi
}

check_redis() {
    echo -n "  Redis: "

    local redis_ping=$(exec_in_container "$CONTAINER_NAME" "root" "redis-cli ping 2>/dev/null")

    if [[ "$redis_ping" == "PONG" ]]; then
        # Get memory usage
        local mem_info=$(exec_in_container "$CONTAINER_NAME" "root" "redis-cli info memory 2>/dev/null | grep used_memory_human")

        if [[ "$mem_info" =~ used_memory_human:([^ ]+) ]]; then
            pass "Redis connected (memory: ${BASH_REMATCH[1]})"
        else
            pass "Redis connected"
        fi
    else
        # Check if Redis is configured
        local cache_driver=$(exec_in_container "$CONTAINER_NAME" "root" "grep CACHE_DRIVER /var/www/october/.env 2>/dev/null")

        if [[ "$cache_driver" == *"redis"* ]]; then
            fail "Redis configured but not responding"
        else
            skip "Redis not configured (using file cache)"
        fi
    fi
}

check_storage() {
    echo -n "  Storage Permissions: "

    local storage_test=$(exec_in_container "$CONTAINER_NAME" "october" \
        "touch /var/www/october/storage/test_write && rm /var/www/october/storage/test_write && echo 'ok'" 2>/dev/null)

    if [[ "$storage_test" == "ok" ]]; then
        pass "Storage is writable"
    else
        fail "Storage directory not writable"
    fi

    # Check bootstrap/cache
    local cache_test=$(exec_in_container "$CONTAINER_NAME" "october" \
        "touch /var/www/october/bootstrap/cache/test_write && rm /var/www/october/bootstrap/cache/test_write && echo 'ok'" 2>/dev/null)

    if [[ "$cache_test" != "ok" ]]; then
        warn "bootstrap/cache not writable"
    fi
}

check_disk_space() {
    echo -n "  Disk Space: "

    local disk_usage=$(exec_in_container "$CONTAINER_NAME" "root" "df -h / | tail -1 | awk '{print \$5}'")

    if [[ -n "$disk_usage" ]]; then
        local usage=${disk_usage%\%}

        if [[ $usage -ge 90 ]]; then
            fail "Disk usage critical: ${usage}%"
        elif [[ $usage -ge 80 ]]; then
            warn "Disk usage high: ${usage}%"
        else
            pass "Disk usage: ${usage}%"
        fi
    else
        warn "Could not check disk space"
    fi
}

check_memory() {
    echo -n "  Memory: "

    local mem_output=$(exec_in_container "$CONTAINER_NAME" "root" \
        "free -m | awk 'NR==2{printf \"%d/%d MB (%.1f%%)\", \$3, \$2, \$3*100/\$2}'")

    if [[ -n "$mem_output" ]]; then
        # Extract percentage
        if [[ "$mem_output" =~ \(([0-9.]+)%\) ]]; then
            local usage=${BASH_REMATCH[1]%.*}

            if [[ $usage -ge 90 ]]; then
                warn "Memory usage high: $mem_output"
            else
                pass "Memory: $mem_output"
            fi
        else
            pass "Memory: $mem_output"
        fi
    else
        warn "Could not check memory"
    fi
}

check_ssl() {
    echo -n "  SSL Certificate: "

    # Check if SSL is configured
    local ssl_enabled=$(exec_in_container "$CONTAINER_NAME" "root" \
        "test -f /etc/apache2/sites-enabled/october-ssl.conf && echo 'enabled'")

    if [[ "$ssl_enabled" != "enabled" ]]; then
        skip "SSL not configured"
        return
    fi

    # Check certificate expiry
    local cert_info=$(exec_in_container "$CONTAINER_NAME" "root" \
        "openssl x509 -enddate -noout -in /etc/letsencrypt/live/*/fullchain.pem 2>/dev/null || \
         openssl x509 -enddate -noout -in /shared/ssl/cert.pem 2>/dev/null")

    if [[ "$cert_info" =~ notAfter=(.+) ]]; then
        local expiry_date="${BASH_REMATCH[1]}"
        local expiry_epoch=$(date -d "$expiry_date" +%s 2>/dev/null || echo "0")
        local now_epoch=$(date +%s)
        local days_left=$(( (expiry_epoch - now_epoch) / 86400 ))

        if [[ $days_left -lt 0 ]]; then
            fail "SSL certificate expired"
        elif [[ $days_left -lt 14 ]]; then
            warn "SSL certificate expires in $days_left days"
        else
            pass "SSL certificate valid ($days_left days remaining)"
        fi
    else
        warn "Could not check SSL certificate"
    fi
}

check_mail() {
    echo -n "  Mail Configuration: "

    local mail_host=$(exec_in_container "$CONTAINER_NAME" "root" \
        "grep -E '^MAIL_HOST=' /var/www/october/.env 2>/dev/null")

    if [[ -n "$mail_host" ]]; then
        local host=${mail_host#MAIL_HOST=}

        if [[ -n "$host" && "$host" != "localhost" && "$host" != "null" ]]; then
            pass "Mail configured: $host"
        else
            warn "Mail not configured for external delivery"
        fi
    else
        warn "Mail configuration not found"
    fi
}

check_scheduler() {
    echo -n "  Scheduler: "

    local cron_status=$(exec_in_container "$CONTAINER_NAME" "root" \
        "supervisorctl status cron 2>/dev/null | grep -q RUNNING && echo 'running'")

    if [[ "$cron_status" == "running" ]]; then
        pass "Scheduler running"
    else
        skip "Scheduler not configured"
    fi
}

check_queue() {
    echo -n "  Queue Workers: "

    local worker_count=$(exec_in_container "$CONTAINER_NAME" "root" \
        "supervisorctl status queue-worker:* 2>/dev/null | grep -c RUNNING || echo 0")

    if [[ -n "$worker_count" && $worker_count -gt 0 ]]; then
        pass "$worker_count queue worker(s) running"
    else
        # Check if queue workers are configured at all
        local queue_config=$(exec_in_container "$CONTAINER_NAME" "root" \
            "supervisorctl status queue-worker:* 2>&1")

        if [[ "$queue_config" == *"no such"* ]] || [[ -z "$queue_config" ]]; then
            skip "Queue workers not configured"
        else
            warn "Queue workers configured but not running"
        fi
    fi

    # Check for failed jobs
    local failed_count=$(exec_in_container "$CONTAINER_NAME" "october" \
        "cd /var/www/october && php artisan queue:failed --json 2>/dev/null | grep -c '\"id\"' || echo 0")

    if [[ -n "$failed_count" && $failed_count -gt 0 ]]; then
        warn "$failed_count failed job(s) in queue"
    fi
}

check_logs() {
    echo -n "  Recent Errors: "

    local error_count=$(exec_in_container "$CONTAINER_NAME" "root" \
        "grep -c 'ERROR\|CRITICAL\|EMERGENCY' /var/www/october/storage/logs/laravel.log 2>/dev/null || echo 0")

    if [[ -n "$error_count" ]]; then
        if [[ $error_count -gt 100 ]]; then
            warn "$error_count errors in log file"
        elif [[ $error_count -gt 0 ]]; then
            pass "$error_count errors in log (review recommended)"
        else
            pass "No errors in log"
        fi
    else
        pass "No log errors found"
    fi
}

show_summary() {
    echo ""
    cyan "═══════════════════════════════════════════════════════════"

    if [[ ${#ISSUES[@]} -eq 0 && ${#WARNINGS[@]} -eq 0 ]]; then
        success "  All checks passed! Your October CMS installation is healthy."
        echo ""
        return 0
    fi

    if [[ ${#ISSUES[@]} -gt 0 ]]; then
        error "  Issues found: ${#ISSUES[@]}"
        for issue in "${ISSUES[@]}"; do
            echo "    - $issue"
        done
    fi

    if [[ ${#WARNINGS[@]} -gt 0 ]]; then
        warning "  Warnings: ${#WARNINGS[@]}"
        for warn_msg in "${WARNINGS[@]}"; do
            echo "    - $warn_msg"
        done
    fi

    echo ""

    if [[ ${#ISSUES[@]} -gt 0 ]]; then
        return 1
    fi

    return 0
}

##############################################################################
# Help
##############################################################################

show_help() {
    cat << 'EOF'
October Docker Health Check Tool

Usage: ./october-doctor [config_name]

Arguments:
  config_name    Name of the container config (default: app)

Options:
  --help, -h     Show this help message
  --version, -v  Show version

This tool performs comprehensive health checks on your October CMS
Docker container, including:

  - Docker status
  - Container status and uptime
  - Database connectivity
  - Redis connection (if configured)
  - Storage permissions
  - Disk space usage
  - Memory usage
  - SSL certificate validity
  - Mail configuration
  - Scheduler status
  - Queue worker status
  - Recent error logs

Examples:
  ./october-doctor          Check the 'app' container
  ./october-doctor mysite   Check the 'mysite' container

EOF
}

##############################################################################
# Main
##############################################################################

main() {
    # Parse arguments
    local config_name="app"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                show_help
                exit 0
                ;;
            -v|--version)
                echo "October Docker Doctor v$VERSION"
                exit 0
                ;;
            -*)
                error "Unknown option: $1"
                echo "Use --help for usage information"
                exit 1
                ;;
            *)
                config_name="$1"
                shift
                ;;
        esac
    done

    CONTAINER_NAME="october_${config_name}"

    # Check Docker is available
    check_docker

    # Check if container exists
    if ! container_exists "$CONTAINER_NAME"; then
        error "Container '$CONTAINER_NAME' does not exist"
        info "Run './launcher bootstrap $config_name' to create it"
        exit 1
    fi

    # Show header
    show_header

    # Run all checks
    check_docker_status
    check_container_status
    check_database
    check_redis
    check_storage
    check_disk_space
    check_memory
    check_ssl
    check_mail
    check_scheduler
    check_queue
    check_logs

    # Show summary and exit with appropriate code
    show_summary
}

# Run main
main "$@"
