#!/usr/bin/env bash
#
# October CMS Docker Setup
# Creates a new site configuration and initializes the site directory
#

set -e

# Script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONTAINERS_DIR="$SCRIPT_DIR/containers"

##############################################################################
# Helper Functions
##############################################################################

# Colors (only if terminal supports it)
if [ -t 1 ]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[1;33m'
    CYAN='\033[0;36m'
    BOLD='\033[1m'
    NC='\033[0m' # No Color
else
    RED=''
    GREEN=''
    YELLOW=''
    CYAN=''
    BOLD=''
    NC=''
fi

info() {
    printf "${CYAN}INFO:${NC} %b\n" "$1"
}

success() {
    printf "${GREEN}SUCCESS:${NC} %b\n" "$1"
}

warning() {
    printf "${YELLOW}WARNING:${NC} %b\n" "$1"
}

error() {
    printf "${RED}ERROR:${NC} %b\n" "$1"
}

fatal() {
    error "$1"
    exit 1
}

# Generate a random password
generate_password() {
    local length="${1:-32}"
    LC_ALL=C tr -dc 'a-zA-Z0-9' < /dev/urandom | head -c "$length"
}

# Generate a base64 app key
generate_app_key() {
    LC_ALL=C tr -dc 'a-zA-Z0-9' < /dev/urandom | head -c 32 | base64
}

# Expand ~ to home directory
expand_path() {
    local path="$1"
    echo "${path/#\~/$HOME}"
}

show_help() {
    printf "${BOLD}October CMS Docker Setup${NC}\n"
    cat << 'EOF'

Usage: ./october-setup <site_name> [options]

Creates a new October CMS site configuration.

Arguments:
  site_name       Name for your site (e.g., blog, shop, myapp)
                  Used for container names and default directory

Options:
  --help, -h      Show this help message

Examples:
  ./october-setup blog          # Interactive setup for a new site
  ./october-setup shop          # Create another site

After setup, start your site with:
  ./launcher start <site_name>
EOF
}

# Parse a value from a YAML config file (simple key: value format)
parse_config_value() {
    local file="$1"
    local key="$2"
    grep "^${key}:" "$file" 2>/dev/null | sed 's/^[^:]*:[[:space:]]*//'
}

# Load existing config into variables
load_existing_config() {
    local config_file="$1"

    ENVIRONMENT=$(parse_config_value "$config_file" "environment")
    SITE_PATH=$(parse_config_value "$config_file" "site_path")
    HTTP_PORT=$(parse_config_value "$config_file" "http_port")
    HTTPS_PORT=$(parse_config_value "$config_file" "https_port")
    HOSTNAME=$(parse_config_value "$config_file" "hostname")
    SSL_MODE=$(parse_config_value "$config_file" "ssl_mode")
    LETSENCRYPT_EMAIL=$(parse_config_value "$config_file" "letsencrypt_email")

    # Parse services section (simple approach)
    USE_MARIADB=$(grep "mariadb:" "$config_file" 2>/dev/null | grep -v "^#" | tail -1 | sed 's/.*:[[:space:]]*//')
    USE_REDIS=$(grep "redis:" "$config_file" 2>/dev/null | grep -v "^#" | tail -1 | sed 's/.*:[[:space:]]*//')

    # Default to true if not specified
    USE_MARIADB="${USE_MARIADB:-true}"
    USE_REDIS="${USE_REDIS:-true}"
}

##############################################################################
# Input Functions
##############################################################################

ask_yes_no() {
    local prompt="$1"
    local default="${2:-y}"
    local response

    if [ "$default" = "y" ]; then
        prompt="$prompt [Y/n]: "
    else
        prompt="$prompt [y/N]: "
    fi

    read -p "$prompt" response
    response="${response:-$default}"

    [[ "$response" =~ ^[Yy] ]]
}

ask_input() {
    local prompt="$1"
    local default="$2"
    local response

    if [ -n "$default" ]; then
        read -p "$prompt [$default]: " response
        echo "${response:-$default}"
    else
        read -p "$prompt: " response
        echo "$response"
    fi
}

ask_choice() {
    local prompt="$1"
    shift
    local options=("$@")

    echo "" >&2
    echo "$prompt" >&2
    echo "" >&2

    local i=1
    for opt in "${options[@]}"; do
        echo "  $i) $opt" >&2
        ((i++))
    done
    echo "" >&2

    local choice
    while true; do
        read -p "Enter choice [1-${#options[@]}]: " choice
        if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#options[@]}" ]; then
            echo "$choice"
            return
        fi
        echo "Please enter a number between 1 and ${#options[@]}" >&2
    done
}

##############################################################################
# Setup Functions
##############################################################################

setup_development() {
    local site_name="$1"

    echo ""
    printf "${BOLD}Development Environment Setup${NC}\n"
    echo "------------------------------"
    echo ""

    # Site path - default to ~/october-sites/{name}
    local default_path="~/october-sites/$site_name"
    SITE_PATH=$(ask_input "Site directory" "$default_path")

    # HTTP port
    HTTP_PORT=$(ask_input "HTTP port" "80")

    # Custom October repo (optional)
    echo ""
    if ask_yes_no "Install from a custom Git repository?" "n"; then
        OCTOBER_REPO=$(ask_input "Git repository URL" "")
        OCTOBER_BRANCH=$(ask_input "Branch (leave empty for default)" "")
    else
        OCTOBER_REPO=""
        OCTOBER_BRANCH=""
    fi

    # Development settings (fixed)
    ENVIRONMENT="development"
    HTTPS_PORT=""
    SSL_MODE="none"
    USE_MARIADB="true"
    USE_REDIS="true"
    HOSTNAME="localhost"
}

setup_production() {
    local site_name="$1"

    echo ""
    printf "${BOLD}Production Environment Setup${NC}\n"
    echo "-----------------------------"
    echo ""

    # Hostname
    HOSTNAME=$(ask_input "Domain name (e.g., forum.example.com)" "")
    while [ -z "$HOSTNAME" ]; do
        error "Domain name is required for production"
        HOSTNAME=$(ask_input "Domain name" "")
    done

    # Site path
    local default_path="~/october-sites/$site_name"
    SITE_PATH=$(ask_input "Site directory" "$default_path")

    # Ports
    HTTP_PORT=$(ask_input "HTTP port" "80")
    HTTPS_PORT=$(ask_input "HTTPS port" "443")

    # SSL
    echo ""
    local ssl_choice=$(ask_choice "SSL Certificate" \
        "Let's Encrypt (automatic, recommended)" \
        "Custom certificate (provide your own)" \
        "None (HTTP only, not recommended)")

    case "$ssl_choice" in
        1)
            SSL_MODE="letsencrypt"
            LETSENCRYPT_EMAIL=$(ask_input "Email for Let's Encrypt notifications" "")
            while [ -z "$LETSENCRYPT_EMAIL" ]; do
                error "Email is required for Let's Encrypt"
                LETSENCRYPT_EMAIL=$(ask_input "Email" "")
            done
            ;;
        2)
            SSL_MODE="custom"
            warning "You will need to mount your certificates into the container"
            ;;
        3)
            SSL_MODE="none"
            warning "Running production without SSL is not recommended"
            ;;
    esac

    # Database
    echo ""
    local db_choice=$(ask_choice "Database" \
        "Bundled MariaDB (runs in container)" \
        "External database (AWS RDS, etc.)")

    if [ "$db_choice" = "1" ]; then
        USE_MARIADB="true"
        EXT_DB_HOST=""
    else
        USE_MARIADB="false"
        EXT_DB_HOST=$(ask_input "Database host" "")
        EXT_DB_PORT=$(ask_input "Database port" "3306")
        EXT_DB_NAME=$(ask_input "Database name" "october")
        EXT_DB_USER=$(ask_input "Database username" "october")
        EXT_DB_PASS=$(ask_input "Database password" "")
    fi

    # Redis
    echo ""
    local redis_choice=$(ask_choice "Redis Cache" \
        "Bundled Redis (runs in container)" \
        "External Redis (AWS ElastiCache, etc.)")

    if [ "$redis_choice" = "1" ]; then
        USE_REDIS="true"
        EXT_REDIS_HOST=""
    else
        USE_REDIS="false"
        EXT_REDIS_HOST=$(ask_input "Redis host" "")
        EXT_REDIS_PORT=$(ask_input "Redis port" "6379")
    fi

    # Custom October repo (optional)
    echo ""
    if ask_yes_no "Install from a custom Git repository?" "n"; then
        OCTOBER_REPO=$(ask_input "Git repository URL" "")
        OCTOBER_BRANCH=$(ask_input "Branch (leave empty for default)" "")
    else
        OCTOBER_REPO=""
        OCTOBER_BRANCH=""
    fi

    ENVIRONMENT="production"
}

create_config_file() {
    local site_name="$1"
    local config_file="$CONTAINERS_DIR/${site_name}.yml"

    mkdir -p "$CONTAINERS_DIR"

    cat > "$config_file" << EOF
# October CMS Site Configuration
# Generated by october-setup on $(date +%Y-%m-%d)

# Environment: development or production
environment: $ENVIRONMENT

# Site directory (where October CMS files live)
site_path: $SITE_PATH

# Network
http_port: $HTTP_PORT
EOF

    if [ "$ENVIRONMENT" = "production" ]; then
        cat >> "$config_file" << EOF
https_port: $HTTPS_PORT
hostname: $HOSTNAME

# SSL: none, letsencrypt, or custom
ssl_mode: $SSL_MODE
EOF

        if [ "$SSL_MODE" = "letsencrypt" ]; then
            echo "letsencrypt_email: $LETSENCRYPT_EMAIL" >> "$config_file"
        fi
    fi

    cat >> "$config_file" << EOF

# Services (set to false to use external services)
services:
  mariadb: $USE_MARIADB
  redis: $USE_REDIS
EOF

    if [ "$USE_MARIADB" = "false" ]; then
        cat >> "$config_file" << EOF

# External database connection
db_host: $EXT_DB_HOST
db_port: ${EXT_DB_PORT:-3306}
db_name: ${EXT_DB_NAME:-october}
db_user: ${EXT_DB_USER:-october}
EOF
    fi

    if [ "$USE_REDIS" = "false" ]; then
        cat >> "$config_file" << EOF

# External Redis connection
redis_host: $EXT_REDIS_HOST
redis_port: ${EXT_REDIS_PORT:-6379}
EOF
    fi

    success "Created configuration: $config_file"
}

create_site_directory() {
    local site_name="$1"
    local expanded_path=$(expand_path "$SITE_PATH")

    # Create site directory
    if [ ! -d "$expanded_path" ]; then
        mkdir -p "$expanded_path" || fatal "Cannot create $expanded_path"
        success "Created site directory: $expanded_path"
    else
        # Check if we can write to existing directory
        if [ ! -w "$expanded_path" ]; then
            echo ""
            fatal "Cannot write to $expanded_path

    The directory exists but you don't have write permission.
    This usually happens when Docker created it as root.

    Fix with: sudo chown -R \$USER:\$USER $expanded_path"
        fi
        info "Site directory already exists: $expanded_path"
    fi

    # Create .data parent directory only - let containers create their
    # own subdirectories (mysql, redis) with correct ownership/permissions
    if [ "$USE_MARIADB" = "true" ] || [ "$USE_REDIS" = "true" ]; then
        if ! mkdir -p "$expanded_path/.data" 2>/dev/null; then
            fatal "Cannot create $expanded_path/.data - permission denied"
        fi
    fi
}

create_env_file() {
    local site_name="$1"
    local expanded_path=$(expand_path "$SITE_PATH")
    local env_file="$expanded_path/.env"

    # Generate passwords
    local app_key=$(generate_app_key)
    local db_password=$(generate_password 24)
    local db_root_password=$(generate_password 24)

    # Determine APP_URL
    local app_url
    if [ "$ENVIRONMENT" = "production" ]; then
        if [ "$SSL_MODE" != "none" ]; then
            app_url="https://$HOSTNAME"
        else
            app_url="http://$HOSTNAME"
        fi
    else
        if [ "$HTTP_PORT" = "80" ]; then
            app_url="http://localhost"
        else
            app_url="http://localhost:$HTTP_PORT"
        fi
    fi

    # Determine environment settings
    local app_env app_debug
    if [ "$ENVIRONMENT" = "production" ]; then
        app_env="production"
        app_debug="false"
    else
        app_env="local"
        app_debug="true"
    fi

    cat > "$env_file" << EOF
# October CMS Environment Configuration
# Generated by october-setup on $(date +%Y-%m-%d)

APP_KEY=base64:$app_key
APP_URL=$app_url
APP_ENV=$app_env
APP_DEBUG=$app_debug

# Database Configuration
EOF

    if [ "$USE_MARIADB" = "true" ]; then
        cat >> "$env_file" << EOF
DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=october
DB_USERNAME=october
DB_PASSWORD=$db_password

# MariaDB container settings
MYSQL_ROOT_PASSWORD=$db_root_password
MYSQL_DATABASE=october
MYSQL_USER=october
MYSQL_PASSWORD=$db_password
EOF
    else
        cat >> "$env_file" << EOF
DB_CONNECTION=mysql
DB_HOST=$EXT_DB_HOST
DB_PORT=${EXT_DB_PORT:-3306}
DB_DATABASE=${EXT_DB_NAME:-october}
DB_USERNAME=${EXT_DB_USER:-october}
DB_PASSWORD=${EXT_DB_PASS:-}
EOF
    fi

    cat >> "$env_file" << EOF

# Redis Configuration
EOF

    if [ "$USE_REDIS" = "true" ]; then
        cat >> "$env_file" << EOF
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_DRIVER=redis
SESSION_DRIVER=redis
EOF
    else
        cat >> "$env_file" << EOF
REDIS_HOST=$EXT_REDIS_HOST
REDIS_PORT=${EXT_REDIS_PORT:-6379}
CACHE_DRIVER=redis
SESSION_DRIVER=redis
EOF
    fi

    # Add October repo if specified
    if [ -n "$OCTOBER_REPO" ]; then
        cat >> "$env_file" << EOF

# Custom October CMS Repository
OCTOBER_REPO=$OCTOBER_REPO
EOF
        if [ -n "$OCTOBER_BRANCH" ]; then
            echo "OCTOBER_BRANCH=$OCTOBER_BRANCH" >> "$env_file"
        fi
    fi

    # Add SSL configuration for production
    if [ "$ENVIRONMENT" = "production" ]; then
        cat >> "$env_file" << EOF

# SSL Configuration
SSL_MODE=$SSL_MODE
APP_HOSTNAME=$HOSTNAME
EOF

        if [ "$SSL_MODE" = "letsencrypt" ]; then
            echo "LETSENCRYPT_EMAIL=$LETSENCRYPT_EMAIL" >> "$env_file"
        fi
    fi

    # Set permissions (readable by all, writable by owner)
    # Docker-compose needs to read this file
    chmod 644 "$env_file"

    success "Created environment file: $env_file"
}

##############################################################################
# Main
##############################################################################

main() {
    # Parse arguments
    if [ $# -lt 1 ] || [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
        show_help
        exit 0
    fi

    local site_name="$1"

    # Validate site name
    if [[ ! "$site_name" =~ ^[a-z][a-z0-9_-]*$ ]]; then
        fatal "Site name must start with a letter and contain only lowercase letters, numbers, hyphens, and underscores"
    fi

    # Check if config already exists
    local config_file="$CONTAINERS_DIR/${site_name}.yml"
    local recreate_site_only=false

    if [ -f "$config_file" ]; then
        # Load existing config to check site directory
        load_existing_config "$config_file"
        local expanded_path=$(expand_path "$SITE_PATH")

        if [ ! -d "$expanded_path" ] || [ ! -f "$expanded_path/.env" ]; then
            # Config exists but site directory or .env is missing
            warning "Configuration exists but site directory is missing or incomplete"
            info "Config: $config_file"
            info "Expected site path: $expanded_path"
            echo ""

            if ask_yes_no "Recreate site directory using existing configuration?" "y"; then
                recreate_site_only=true
            else
                warning "Configuration already exists: $config_file"
                if ! ask_yes_no "Overwrite existing configuration?" "n"; then
                    info "Setup cancelled"
                    exit 0
                fi
            fi
        else
            # Both config and site exist
            warning "Configuration already exists: $config_file"
            if ! ask_yes_no "Overwrite existing configuration?" "n"; then
                info "Setup cancelled"
                exit 0
            fi
        fi
    fi

    if [ "$recreate_site_only" = "true" ]; then
        # Just recreate site directory and .env using existing config
        echo ""
        printf "${BOLD}Recreating Site Directory${NC}\n"
        echo "-------------------------"
        echo ""

        create_site_directory "$site_name"
        create_env_file "$site_name"
    else
        # Full setup flow
        # Welcome message
        echo ""
        printf "${BOLD}October CMS Docker Setup${NC}\n"
        echo "========================="
        echo ""
        echo "Setting up site: $site_name"
        echo ""

        # Ask environment type
        local env_choice=$(ask_choice "What type of environment is this?" \
            "Development (local machine, debugging enabled)" \
            "Production (server, optimized for performance)")

        case "$env_choice" in
            1)
                setup_development "$site_name"
                ;;
            2)
                setup_production "$site_name"
                ;;
        esac

        # Create files
        echo ""
        printf "${BOLD}Creating Configuration${NC}\n"
        echo "----------------------"
        echo ""

        create_config_file "$site_name"
        create_site_directory "$site_name"
        create_env_file "$site_name"
    fi

    # Summary
    local expanded_path=$(expand_path "$SITE_PATH")

    echo ""
    echo "============================================================"
    printf "${GREEN}${BOLD}Setup Complete!${NC}\n"
    echo "============================================================"
    echo ""
    echo "Configuration: $config_file"
    echo "Site directory: $expanded_path"
    echo "Environment: $ENVIRONMENT"
    echo ""
    echo "Next steps:"
    echo ""
    echo "  1. Start your site:"
    echo "     ./launcher start $site_name"
    echo ""
    echo "  2. Access your site at:"
    if [ "$ENVIRONMENT" = "production" ] && [ "$SSL_MODE" != "none" ]; then
        echo "     https://$HOSTNAME"
    elif [ "$HTTP_PORT" = "80" ]; then
        echo "     http://localhost"
    else
        echo "     http://localhost:$HTTP_PORT"
    fi
    echo ""

    if [ "$ENVIRONMENT" = "development" ]; then
        echo "  3. For VS Code development:"
        echo "     - Open the site directory in VS Code"
        echo "     - Use 'Reopen in Container' for full IDE integration"
        echo ""
    fi

    echo "Other commands:"
    echo "  ./launcher stop $site_name      Stop the site"
    echo "  ./launcher logs $site_name      View logs"
    echo "  ./launcher enter $site_name     Shell access"
    echo "  ./launcher status               Show all sites"
    echo ""
}

main "$@"
