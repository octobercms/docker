#!/usr/bin/env bash
#
# October Docker Setup Wizard
# Interactive setup for October CMS Docker deployment
#
# No host dependencies beyond Bash and Docker
#

set -e

# Paths
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONTAINERS_DIR="$SCRIPT_DIR/containers"
SAMPLES_DIR="$SCRIPT_DIR/samples"

# Config name (default: app)
APP_NAME="app"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

##############################################################################
# Helper Functions
##############################################################################

info() {
    echo -e "${CYAN}INFO:${NC} $1"
}

success() {
    echo -e "${GREEN}SUCCESS:${NC} $1"
}

warning() {
    echo -e "${YELLOW}WARNING:${NC} $1"
}

error() {
    echo -e "${RED}ERROR:${NC} $1"
}

fatal() {
    error "$1"
    exit 1
}

# Ask a question with optional default
ask() {
    local prompt="$1"
    local default="$2"
    local result

    if [[ -n "$default" ]]; then
        read -p "$prompt [$default]: " result
        echo "${result:-$default}"
    else
        read -p "$prompt: " result
        echo "$result"
    fi
}

# Ask yes/no question
confirm() {
    local prompt="$1"
    local default="${2:-n}"
    local yn_prompt

    if [[ "$default" == "y" ]]; then
        yn_prompt="[Y/n]"
    else
        yn_prompt="[y/N]"
    fi

    read -p "$prompt $yn_prompt: " answer
    answer="${answer:-$default}"

    [[ "$answer" =~ ^[Yy] ]]
}

# Generate random string
random_string() {
    local length="${1:-32}"
    cat /dev/urandom | tr -dc 'a-zA-Z0-9' | fold -w "$length" | head -n 1
}

# Generate Laravel-compatible APP_KEY
generate_app_key() {
    local key=$(random_string 32)
    echo "base64:$(echo -n "$key" | base64)"
}

# Read a value from the config file
read_config() {
    local key="$1"
    local line=$(grep -E "^  #?$key:" "$CONFIG_FILE" 2>/dev/null || true)
    local value=$(echo "$line" | sed 's/^[^:]*:[[:space:]]*//' | sed 's/^"\(.*\)"$/\1/' | sed "s/^'\(.*\)'$/\1/")
    echo "$value"
}

# Update a value in the config file using sed
# Returns 0 if change was made, 1 otherwise
update_config() {
    local key="$1"
    local value="$2"
    local changelog="/tmp/changelog.$$"

    # Escape special characters in value for sed
    local escaped_value=$(echo "$value" | sed 's/[&/\]/\\&/g')

    # Try to update the line
    sed -i -e "s|^  #\?$key:.*|  $key: \"$escaped_value\"|w $changelog" "$CONFIG_FILE"

    if [ -s "$changelog" ]; then
        rm -f "$changelog"
        return 0
    else
        rm -f "$changelog"
        return 1
    fi
}

# Update a value without quotes (for booleans, numbers)
update_config_raw() {
    local key="$1"
    local value="$2"
    local changelog="/tmp/changelog.$$"

    sed -i -e "s|^  #\?$key:.*|  $key: $value|w $changelog" "$CONFIG_FILE"

    if [ -s "$changelog" ]; then
        rm -f "$changelog"
        return 0
    else
        rm -f "$changelog"
        return 1
    fi
}

# Uncomment a template line
enable_template() {
    local template="$1"
    local changelog="/tmp/changelog.$$"

    # Escape slashes for sed
    local escaped_template=$(echo "$template" | sed 's/\//\\\//g')

    # Match commented line and uncomment it
    sed -i -e "s|^  # *- \"$escaped_template\"|  - \"$escaped_template\"|w $changelog" "$CONFIG_FILE"

    if [ -s "$changelog" ]; then
        rm -f "$changelog"
        return 0
    else
        rm -f "$changelog"
        return 1
    fi
}

# Uncomment a port expose line
enable_port() {
    local port="$1"
    local changelog="/tmp/changelog.$$"

    sed -i -e "s|^  # *- \"$port\"|  - \"$port\"|w $changelog" "$CONFIG_FILE"

    if [ -s "$changelog" ]; then
        rm -f "$changelog"
        return 0
    else
        rm -f "$changelog"
        return 1
    fi
}

# Uncomment an env variable line
enable_env() {
    local key="$1"
    local changelog="/tmp/changelog.$$"

    sed -i -e "s|^  # *$key:|  $key:|w $changelog" "$CONFIG_FILE"

    if [ -s "$changelog" ]; then
        rm -f "$changelog"
        return 0
    else
        rm -f "$changelog"
        return 1
    fi
}

##############################################################################
# Prerequisites Check
##############################################################################

check_docker() {
    if ! command -v docker &> /dev/null; then
        echo -e "${RED}NOT FOUND${NC}"
        error "Docker is required. Please install Docker first."
        return 1
    fi

    if ! docker info &> /dev/null; then
        echo -e "${RED}NOT RUNNING${NC}"
        error "Docker daemon is not running. Please start Docker."
        return 1
    fi

    return 0
}

check_prerequisites() {
    info "Checking prerequisites..."
    echo

    # Check Docker
    echo -n "  Docker: "
    if check_docker; then
        local version=$(docker version --format '{{.Server.Version}}' 2>/dev/null || echo "unknown")
        echo -e "${GREEN}OK${NC} (v$version)"
    else
        return 1
    fi

    # Check disk space
    echo -n "  Disk space: "
    local free_gb=$(df -BG . 2>/dev/null | awk 'NR==2 {print $4}' | tr -d 'G' || echo "0")
    if [[ "$free_gb" -ge 5 ]]; then
        echo -e "${GREEN}OK${NC} (${free_gb}GB free)"
    elif [[ "$free_gb" -ge 2 ]]; then
        echo -e "${YELLOW}WARNING${NC} (${free_gb}GB free)"
        warning "Recommended: at least 5GB free disk space"
    else
        echo -e "${RED}LOW${NC} (${free_gb}GB free)"
        error "Insufficient disk space. At least 2GB required."
        return 1
    fi

    # Check memory
    echo -n "  System memory: "
    local mem_mb=0
    if [[ -f /proc/meminfo ]]; then
        mem_mb=$(awk '/MemTotal/ {print int($2/1024)}' /proc/meminfo)
    elif command -v sysctl &> /dev/null; then
        mem_mb=$(( $(sysctl -n hw.memsize 2>/dev/null || echo 0) / 1024 / 1024 ))
    fi

    if [[ "$mem_mb" -ge 2048 ]]; then
        echo -e "${GREEN}OK${NC} ($((mem_mb/1024))GB)"
    elif [[ "$mem_mb" -ge 1024 ]]; then
        echo -e "${YELLOW}WARNING${NC} ($((mem_mb/1024))GB)"
        warning "Recommended: at least 2GB RAM"
    else
        echo -e "${YELLOW}UNKNOWN${NC}"
    fi

    echo
    return 0
}

##############################################################################
# Sample Selection
##############################################################################

# Sample descriptions for menu display
get_sample_description() {
    local sample="$1"
    case "$sample" in
        standalone.yml)
            echo "All-in-one: MySQL + Redis + Web (recommended for most users)"
            ;;
        standalone-dev.yml)
            echo "Development: Xdebug, debug mode, development settings"
            ;;
        web-only.yml)
            echo "Web only: Connect to external MySQL and Redis"
            ;;
        data.yml)
            echo "Data only: MySQL + Redis server (use with web-only)"
            ;;
        *)
            echo "Custom configuration"
            ;;
    esac
}

# Get recommended config name for a sample
# Multi-container setups (data.yml, web-only.yml) need distinct names
# Standalone configs always default to "app"
get_default_config_name() {
    local sample="$1"
    case "$sample" in
        web-only.yml)
            echo "web"
            ;;
        data.yml)
            echo "data"
            ;;
        *)
            echo "app"
            ;;
    esac
}

select_sample() {
    echo -e "${BOLD}=== Select Configuration Type ===${NC}"
    echo
    echo "Available configurations:"
    echo

    # Find all samples
    local samples=()
    local i=1
    for sample_file in "$SAMPLES_DIR"/*.yml; do
        [[ -f "$sample_file" ]] || continue
        local sample_name=$(basename "$sample_file")
        local description=$(get_sample_description "$sample_name")
        samples+=("$sample_name")
        echo "  $i) $sample_name"
        echo "     $description"
        echo
        ((i++))
    done

    if [[ ${#samples[@]} -eq 0 ]]; then
        fatal "No sample configurations found in $SAMPLES_DIR"
    fi

    # Ask user to select
    local selection
    while true; do
        read -p "Select configuration [1]: " selection
        selection="${selection:-1}"

        if [[ "$selection" =~ ^[0-9]+$ ]] && [[ "$selection" -ge 1 ]] && [[ "$selection" -le ${#samples[@]} ]]; then
            SELECTED_SAMPLE="${samples[$((selection-1))]}"
            SAMPLE_FILE="$SAMPLES_DIR/$SELECTED_SAMPLE"
            break
        else
            error "Invalid selection. Please enter a number between 1 and ${#samples[@]}"
        fi
    done

    echo
    info "Selected: $SELECTED_SAMPLE"
    echo

    # Suggest default config name based on sample
    local suggested_name=$(get_default_config_name "$SELECTED_SAMPLE")
    APP_NAME=$(ask "Configuration name" "$suggested_name")

    # Validate config name
    if [[ ! "$APP_NAME" =~ ^[a-zA-Z0-9_-]+$ ]]; then
        fatal "Invalid config name '$APP_NAME'. Use only letters, numbers, underscores, and hyphens."
    fi

    CONFIG_FILE="$CONTAINERS_DIR/$APP_NAME.yml"
    echo
}

##############################################################################
# Resource Scaling (auto-tune based on system resources)
##############################################################################

scale_resources() {
    local changelog="/tmp/changelog.$$"

    # Get system memory in GB
    local avail_gb=2
    if [[ -f /proc/meminfo ]]; then
        local mem_mb=$(awk '/MemTotal/ {print int($2/1024)}' /proc/meminfo)
        avail_gb=$((mem_mb / 1024))
    elif command -v sysctl &> /dev/null; then
        local mem_bytes=$(sysctl -n hw.memsize 2>/dev/null || echo 0)
        avail_gb=$((mem_bytes / 1024 / 1024 / 1024))
    fi

    echo "Found ${avail_gb}GB of memory"

    # db_innodb_buffer_pool_size: 128MB for 1GB, 256MB for 2GB, or 256MB * GB, max 512MB
    local db_buffer
    if [ "$avail_gb" -eq "1" ]; then
        db_buffer=128
    elif [ "$avail_gb" -eq "2" ]; then
        db_buffer=256
    else
        db_buffer=$(( 256 * avail_gb ))
    fi
    [ "$db_buffer" -gt 512 ] && db_buffer=512

    sed -i -e "s|^  db_innodb_buffer_pool_size:.*|  db_innodb_buffer_pool_size: \"${db_buffer}M\"|w $changelog" "$CONFIG_FILE"
    if [ -s "$changelog" ]; then
        echo "Setting db_innodb_buffer_pool_size = ${db_buffer}M"
        rm -f "$changelog"
    fi

    # php_memory_limit: 25% of RAM, min 128M, max 512M
    local php_mem=$((avail_gb * 1024 / 4))
    [ "$php_mem" -lt 128 ] && php_mem=128
    [ "$php_mem" -gt 512 ] && php_mem=512

    sed -i -e "s|^  php_memory_limit:.*|  php_memory_limit: ${php_mem}M|w $changelog" "$CONFIG_FILE"
    if [ -s "$changelog" ]; then
        echo "Setting php_memory_limit = ${php_mem}M"
        rm -f "$changelog"
    fi

    # redis_maxmemory: 10% of RAM, min 32mb, max 256mb
    local redis_mem=$((avail_gb * 1024 / 10))
    [ "$redis_mem" -lt 32 ] && redis_mem=32
    [ "$redis_mem" -gt 256 ] && redis_mem=256

    sed -i -e "s|^  redis_maxmemory:.*|  redis_maxmemory: \"${redis_mem}mb\"|w $changelog" "$CONFIG_FILE"
    if [ -s "$changelog" ]; then
        echo "Setting redis_maxmemory = ${redis_mem}mb"
        rm -f "$changelog"
    fi

    echo
}

##############################################################################
# User Configuration Prompts
##############################################################################

ask_user_for_config() {
    local changelog="/tmp/changelog.$$"
    local new_value=""
    local config_ok="n"
    local update_ok="y"

    # Read current values from config
    local hostname=$(read_config "APP_URL" | sed 's|^https\?://||')
    local db_password=$(read_config "db_password")
    local db_host=$(read_config "DB_HOST")
    local app_key=$(read_config "APP_KEY")

    # SSL configuration
    local use_ssl="n"
    local letsencrypt_email=""

    echo -e "${BOLD}=== Site Configuration ===${NC}"
    echo

    while [[ "$config_ok" == "n" ]]; do
        # Hostname
        if [ ! -z "$hostname" ]; then
            read -p "Hostname for your October CMS site? [$hostname]: " new_value
            if [ ! -z "$new_value" ]; then
                hostname="$new_value"
            fi
        fi

        # Check if IP address (warn but allow)
        if [[ $hostname =~ ^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$ ]]; then
            echo
            warning "October CMS works best with a DNS hostname. IP addresses may cause issues with cookies/sessions."
            warning "SSL/HTTPS requires a domain name and cannot be used with IP addresses."
            echo
            use_ssl="n"
        else
            # Only offer SSL for non-localhost domains
            if [[ "$hostname" != "localhost" ]]; then
                echo
                if confirm "Enable HTTPS with Let's Encrypt?" "y"; then
                    use_ssl="y"
                    letsencrypt_email=$(ask "Email for Let's Encrypt notifications" "admin@$hostname")
                fi
            fi
        fi

        echo -e "\nDoes this look right?\n"
        echo "Hostname: $hostname"
        if [[ "$use_ssl" == "y" ]]; then
            echo "App URL:  https://$hostname"
            echo "SSL:      Let's Encrypt (email: $letsencrypt_email)"
        else
            echo "App URL:  http://$hostname"
            echo "SSL:      Disabled"
        fi
        echo ""
        read -p "ENTER to continue, 'n' to try again, Ctrl+C to exit: " config_ok
    done

    # Update APP_URL (with https if SSL enabled)
    if [[ "$use_ssl" == "y" ]]; then
        update_config "APP_URL" "https://$hostname" || {
            echo "APP_URL change failed."
            update_ok="n"
        }

        # Enable SSL templates
        info "Enabling SSL templates..."
        enable_template "templates/web.ssl.template.yml" || echo "web.ssl.template.yml NOT ENABLED -- was it already enabled?"
        enable_template "templates/web.letsencrypt.template.yml" || echo "web.letsencrypt.template.yml NOT ENABLED -- was it already enabled?"

        # Enable 443 port
        enable_port "443:443" || echo "Port 443 NOT ENABLED -- was it already enabled?"

        # Enable and set LETSENCRYPT_EMAIL
        enable_env "LETSENCRYPT_EMAIL"
        update_config "LETSENCRYPT_EMAIL" "$letsencrypt_email" || {
            echo "LETSENCRYPT_EMAIL change failed."
            update_ok="n"
        }
    else
        update_config "APP_URL" "http://$hostname" || {
            echo "APP_URL change failed."
            update_ok="n"
        }
    fi

    # Generate and update passwords only for standalone configs (internal DB)
    if [[ "$db_host" == "127.0.0.1" ]] && [[ "$db_password" == *"CHANGE_THIS"* || "$db_password" == "development" ]]; then
        echo
        info "Generating secure database passwords..."

        local new_db_password=$(random_string 16)
        local new_root_password=$(random_string 20)

        update_config "db_password" "$new_db_password" || {
            echo "db_password change failed."
            update_ok="n"
        }

        update_config "db_root_password" "$new_root_password" || {
            echo "db_root_password change failed."
            update_ok="n"
        }

        update_config "DB_PASSWORD" "$new_db_password" || {
            echo "DB_PASSWORD change failed."
            update_ok="n"
        }
    fi

    # Generate APP_KEY if it's a placeholder
    if [[ "$app_key" == *"CHANGE_THIS"* || "$app_key" == *"GENERATE"* ]]; then
        info "Generating secure APP_KEY..."
        local new_app_key=$(generate_app_key)

        update_config "APP_KEY" "$new_app_key" || {
            echo "APP_KEY change failed."
            update_ok="n"
        }
    fi

    if [ "$update_ok" == "y" ]; then
        echo -e "\nConfiguration file at $CONFIG_FILE updated successfully!\n"
    else
        echo -e "\nUnfortunately, there was an error updating $CONFIG_FILE\n"
        echo -e "You may need to edit the file manually."
        exit 1
    fi
}

##############################################################################
# Validation
##############################################################################

validate_config() {
    local valid_config="y"

    # Check that placeholder values have been changed
    local app_key=$(read_config "APP_KEY")
    if [[ "$app_key" == *"CHANGE_THIS"* ]] || [[ "$app_key" == *"GENERATE"* ]]; then
        echo "APP_KEY still has placeholder value"
        valid_config="n"
    fi

    local app_url=$(read_config "APP_URL")
    if [[ "$app_url" == *"example.com"* ]]; then
        echo "APP_URL still has example.com placeholder"
        valid_config="n"
    fi

    # For standalone configs, check db_password
    local db_host=$(read_config "DB_HOST")
    if [[ "$db_host" == "127.0.0.1" ]]; then
        local db_password=$(read_config "db_password")
        if [[ "$db_password" == *"CHANGE_THIS"* ]]; then
            echo "db_password still has placeholder value"
            valid_config="n"
        fi
    fi

    if [ "$valid_config" != "y" ]; then
        echo -e "\nSorry, these $CONFIG_FILE settings aren't valid -- can't continue!"
        echo "Please edit $CONFIG_FILE manually or run this setup again."
        exit 1
    fi
}

##############################################################################
# Main
##############################################################################

show_welcome() {
    echo
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║                                                          ║${NC}"
    echo -e "${CYAN}║            October CMS Docker Setup Wizard               ║${NC}"
    echo -e "${CYAN}║                                                          ║${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════╝${NC}"
    echo
    info "This wizard will help you configure October CMS for Docker."
    info "Press Ctrl+C at any time to cancel."
    echo
}

show_help() {
    cat << EOF
October Docker Setup Wizard

Usage: ./october-setup [options] [config_name]
       ./october-setup --help

Arguments:
  config_name   Name for the configuration (will be prompted if not provided)
                Creates containers/<config_name>.yml

Options:
  --help, -h      Show this help message
  --skip-rebuild  Configure only, don't offer to bootstrap

This interactive wizard will guide you through configuring October CMS
for Docker deployment. It will:

  1. Check system prerequisites (Docker, disk space, memory)
  2. Let you select a sample configuration to use
  3. Copy the sample to containers/<config_name>.yml
  4. Auto-tune resources based on your system
  5. Configure your site hostname and SSL/HTTPS
  6. Generate secure passwords and APP_KEY
  7. Optionally bootstrap the container

Available sample configurations:
  standalone.yml      All-in-one with MySQL + Redis + Web (recommended)
  standalone-dev.yml  Development environment with Xdebug
  web-only.yml        Web server only (external database)
  data.yml            Data services only (MySQL + Redis)

Examples:
  ./october-setup                    # Interactive setup
  ./october-setup mysite             # Use 'mysite' as config name
  ./october-setup --skip-rebuild     # Configure without bootstrapping

After setup, you can:
  - Start the container:  ./launcher start <config>
  - Enter the container:  ./launcher enter <config>
  - View logs:            ./launcher logs <config>
  - Rebuild:              ./launcher rebuild <config>

Requirements:
  - Docker (that's it!)

EOF
}

main() {
    # Parse arguments
    SKIP_REBUILD=""
    CUSTOM_NAME=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --help|-h)
                show_help
                exit 0
                ;;
            --skip-rebuild)
                SKIP_REBUILD="1"
                ;;
            -*)
                error "Unknown option: $1"
                echo "Run './october-setup --help' for usage."
                exit 1
                ;;
            *)
                # First non-option argument is the config name
                if [[ -z "$CUSTOM_NAME" ]]; then
                    CUSTOM_NAME="$1"
                fi
                ;;
        esac
        shift
    done

    show_welcome

    # Check prerequisites
    if ! check_prerequisites; then
        exit 1
    fi

    # Ensure containers directory exists
    mkdir -p "$CONTAINERS_DIR"

    # Let user select sample configuration
    select_sample

    # If custom name was provided via command line, use it
    if [[ -n "$CUSTOM_NAME" ]]; then
        APP_NAME="$CUSTOM_NAME"
        CONFIG_FILE="$CONTAINERS_DIR/$APP_NAME.yml"
    fi

    # Check for existing config
    if [ -f "$CONFIG_FILE" ]; then
        echo "The configuration file $CONFIG_FILE already exists!"
        echo
        if ! confirm "Do you want to reconfigure it?" "n"; then
            info "Setup cancelled. Existing configuration preserved."
            exit 0
        fi
        echo ". . . reconfiguring . . ."
        echo
        DATE=$(date +"%Y-%m-%d-%H%M%S")
        BACKUP="$APP_NAME.yml.$DATE.bak"
        echo "Saving old file as $BACKUP"
        cp "$CONFIG_FILE" "$CONTAINERS_DIR/$BACKUP"
        echo
    else
        # Copy sample file to containers directory
        info "Creating configuration from $SELECTED_SAMPLE..."
        cp "$SAMPLE_FILE" "$CONFIG_FILE"
        chmod 600 "$CONFIG_FILE"
    fi

    # Scale resources based on system
    info "Auto-tuning resources based on your system..."
    scale_resources

    # Ask user for configuration
    ask_user_for_config

    # Validate configuration
    validate_config

    # Offer to bootstrap (unless --skip-rebuild)
    if [ "$SKIP_REBUILD" ]; then
        echo
        success "Configuration saved to: $CONFIG_FILE"
        info "Run './launcher bootstrap $APP_NAME' when ready to start."
        exit 0
    fi

    echo
    if confirm "Would you like to bootstrap the container now?" "y"; then
        echo
        info "Bootstrapping container..."
        sleep 2
        "$SCRIPT_DIR/launcher" bootstrap "$APP_NAME"
    else
        echo
        success "Configuration saved to: $CONFIG_FILE"
        info "Run './launcher bootstrap $APP_NAME' when ready to start."
    fi
}

main "$@"
