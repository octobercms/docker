#!/usr/bin/env bash
#
# October Docker Launcher
# A Docker-based deployment system for October CMS
#
# No host dependencies beyond Bash and Docker
#

set -e

# Configuration
VERSION="1.0.0"
DEFAULT_IMAGE="octobercms/base:1.0"

# Paths (relative to script location)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONTAINERS_DIR="$SCRIPT_DIR/containers"
TEMPLATES_DIR="$SCRIPT_DIR/templates"
SHARED_DIR="$SCRIPT_DIR/shared"
CIDS_DIR="$SCRIPT_DIR/cids"
SAMPLES_DIR="$SCRIPT_DIR/samples"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# Debug mode
DEBUG=${DEBUG:-0}

##############################################################################
# Helper Functions
##############################################################################

info() {
    echo -e "${CYAN}INFO:${NC} $1"
}

success() {
    echo -e "${GREEN}SUCCESS:${NC} $1"
}

warning() {
    echo -e "${YELLOW}WARNING:${NC} $1"
}

error() {
    echo -e "${RED}ERROR:${NC} $1"
}

fatal() {
    error "$1"
    exit 1
}

debug() {
    if [[ "$DEBUG" == "1" ]]; then
        echo -e "${CYAN}DEBUG:${NC} $1"
    fi
}

##############################################################################
# Docker Detection
##############################################################################

check_docker() {
    if ! command -v docker &> /dev/null; then
        fatal "Docker not found. Please install Docker first."
    fi

    if ! docker info &> /dev/null; then
        fatal "Docker daemon is not running. Please start Docker."
    fi

    debug "Docker is available"
}

# Get docker path - quote it to handle spaces in Windows paths
docker_path="$(which docker 2>/dev/null || echo "/usr/bin/docker")"

# Function to run docker commands (handles paths with spaces)
run_docker() {
    "$docker_path" "$@"
}

##############################################################################
# YAML Parsing (via PHP in Docker)
# This is the key trick - we run PHP inside a container to parse YAML
##############################################################################

# Parse a YAML value from config file
yaml_get() {
    local config_file="$1"
    local key="$2"
    local default="$3"

    local php_code="
        \$yaml = yaml_parse(file_get_contents('php://stdin'));
        \$keys = explode('.', '$key');
        \$value = \$yaml;
        foreach (\$keys as \$k) {
            \$value = \$value[\$k] ?? null;
            if (\$value === null) break;
        }
        echo \$value ?? '$default';
    "

    cat "$config_file" | "$docker_path" run --rm -i -a stdin -a stdout "$DEFAULT_IMAGE" \
        php -r "$php_code" 2>/dev/null || echo "$default"
}

# Get array values from YAML (one per line)
yaml_get_array() {
    local config_file="$1"
    local key="$2"

    local php_code="
        \$yaml = yaml_parse(file_get_contents('php://stdin'));
        \$keys = explode('.', '$key');
        \$value = \$yaml;
        foreach (\$keys as \$k) {
            \$value = \$value[\$k] ?? null;
            if (\$value === null) break;
        }
        if (is_array(\$value)) {
            foreach (\$value as \$item) {
                if (is_string(\$item)) {
                    echo \$item . PHP_EOL;
                }
            }
        }
    "

    cat "$config_file" | "$docker_path" run --rm -i -a stdin -a stdout "$DEFAULT_IMAGE" \
        php -r "$php_code" 2>/dev/null
}

# Get environment variables from config
yaml_get_env() {
    local config_file="$1"

    local php_code="
        \$yaml = yaml_parse(file_get_contents('php://stdin'));
        \$env = \$yaml['env'] ?? [];
        foreach (\$env as \$key => \$value) {
            echo \$key . '=' . \$value . PHP_EOL;
        }
    "

    cat "$config_file" | "$docker_path" run --rm -i -a stdin -a stdout "$DEFAULT_IMAGE" \
        php -r "$php_code" 2>/dev/null
}

# Get volumes from config
yaml_get_volumes() {
    local config_file="$1"
    local config_name="$2"

    local php_code="
        \$yaml = yaml_parse(file_get_contents('php://stdin'));
        \$volumes = \$yaml['volumes'] ?? [];
        foreach (\$volumes as \$vol) {
            if (isset(\$vol['volume'])) {
                \$host = \$vol['volume']['host'] ?? '';
                \$guest = \$vol['volume']['guest'] ?? '';
                \$host = str_replace(['{{ config }}', '{{config}}'], '$config_name', \$host);
                if (\$host && \$guest) {
                    echo \$host . ':' . \$guest . PHP_EOL;
                }
            }
        }
    "

    cat "$config_file" | "$docker_path" run --rm -i -a stdin -a stdout "$DEFAULT_IMAGE" \
        php -r "$php_code" 2>/dev/null
}

# Get exposed ports from config
yaml_get_ports() {
    local config_file="$1"

    local php_code="
        \$yaml = yaml_parse(file_get_contents('php://stdin'));
        \$expose = \$yaml['expose'] ?? [];
        foreach (\$expose as \$port) {
            echo \$port . PHP_EOL;
        }
    "

    cat "$config_file" | "$docker_path" run --rm -i -a stdin -a stdout "$DEFAULT_IMAGE" \
        php -r "$php_code" 2>/dev/null
}

##############################################################################
# Container Management
##############################################################################

get_container_name() {
    echo "october_$1"
}

container_exists() {
    local name="$1"
    "$docker_path" container inspect "$name" &> /dev/null
}

container_running() {
    local name="$1"
    local state=$("$docker_path" container inspect --format '{{.State.Running}}' "$name" 2>/dev/null)
    [[ "$state" == "true" ]]
}

get_config_file() {
    local config="$1"
    local config_file="$CONTAINERS_DIR/$config.yml"

    if [[ ! -f "$config_file" ]]; then
        fatal "Configuration file not found: $config_file"
    fi

    echo "$config_file"
}

##############################################################################
# Commands
##############################################################################

cmd_start() {
    local config="$1"
    [[ -z "$config" ]] && fatal "Usage: ./launcher start <config>"

    local container_name=$(get_container_name "$config")

    if ! container_exists "$container_name"; then
        error "Container '$container_name' does not exist"
        info "Run './launcher bootstrap $config' first"
        exit 1
    fi

    if container_running "$container_name"; then
        warning "Container '$container_name' is already running"
        return 0
    fi

    info "Starting container: $container_name"
    "$docker_path" start "$container_name"
    success "Container started"
}

cmd_stop() {
    local config="$1"
    [[ -z "$config" ]] && fatal "Usage: ./launcher stop <config>"

    local container_name=$(get_container_name "$config")

    if ! container_exists "$container_name"; then
        warning "Container '$container_name' does not exist"
        return 0
    fi

    if ! container_running "$container_name"; then
        warning "Container '$container_name' is not running"
        return 0
    fi

    info "Stopping container: $container_name"
    "$docker_path" stop -t 30 "$container_name"
    success "Container stopped"
}

cmd_restart() {
    local config="$1"
    [[ -z "$config" ]] && fatal "Usage: ./launcher restart <config>"

    cmd_stop "$config"
    cmd_start "$config"
}

cmd_destroy() {
    local config="$1"
    [[ -z "$config" ]] && fatal "Usage: ./launcher destroy <config>"

    local container_name=$(get_container_name "$config")

    if ! container_exists "$container_name"; then
        warning "Container '$container_name' does not exist"
        return 0
    fi

    if container_running "$container_name"; then
        info "Stopping container first..."
        "$docker_path" stop -t 10 "$container_name" || true
    fi

    info "Removing container: $container_name"
    "$docker_path" rm -f "$container_name"
    success "Container removed"
}

cmd_enter() {
    local config="$1"
    [[ -z "$config" ]] && fatal "Usage: ./launcher enter <config>"

    local container_name=$(get_container_name "$config")

    if ! container_running "$container_name"; then
        fatal "Container '$container_name' is not running"
    fi

    info "Entering container: $container_name"
    info "Type 'exit' to leave"
    "$docker_path" exec -it "$container_name" bash
}

cmd_logs() {
    local config="$1"
    [[ -z "$config" ]] && fatal "Usage: ./launcher logs <config> [-f]"

    local container_name=$(get_container_name "$config")
    shift

    if ! container_exists "$container_name"; then
        fatal "Container '$container_name' does not exist"
    fi

    "$docker_path" logs "$@" "$container_name"
}

cmd_bootstrap() {
    local config="$1"
    [[ -z "$config" ]] && fatal "Usage: ./launcher bootstrap <config>"

    check_docker

    # Validate config file exists before proceeding
    local config_file="$CONTAINERS_DIR/$config.yml"
    if [[ ! -f "$config_file" ]]; then
        error "Configuration file not found: $config_file"
        echo ""
        echo "To create a new configuration, either:"
        echo "  1. Run './october-setup' to use the interactive setup wizard"
        echo "  2. Copy a sample: cp samples/standalone.yml containers/$config.yml"
        echo ""
        # List available configs if any exist
        if ls "$CONTAINERS_DIR"/*.yml &>/dev/null; then
            echo "Available configs: $(cd "$CONTAINERS_DIR" && ls -1 *.yml 2>/dev/null | sed 's/\.yml$//' | tr '\n' ' ')"
        fi
        exit 1
    fi

    local container_name=$(get_container_name "$config")

    info "Bootstrapping container: $container_name"
    debug "Config file: $config_file"

    # Get base image
    local base_image=$(yaml_get "$config_file" "base_image" "$DEFAULT_IMAGE")
    debug "Base image: $base_image"

    # Pull image if needed
    if ! "$docker_path" image inspect "$base_image" &> /dev/null; then
        info "Pulling image: $base_image"
        "$docker_path" pull "$base_image"
    fi

    # Remove existing container
    if container_exists "$container_name"; then
        warning "Removing existing container: $container_name"
        "$docker_path" stop -t 10 "$container_name" 2>/dev/null || true
        "$docker_path" rm -f "$container_name" 2>/dev/null || true
    fi

    # Build docker run command
    local run_args="-d --restart unless-stopped"
    run_args="$run_args --name $container_name"
    run_args="$run_args --hostname $config"

    # Add environment variables
    while IFS= read -r env_line; do
        [[ -n "$env_line" ]] && run_args="$run_args -e \"$env_line\""
    done < <(yaml_get_env "$config_file")

    # Add volumes from main config
    while IFS= read -r vol_line; do
        if [[ -n "$vol_line" ]]; then
            local host_path=$(echo "$vol_line" | cut -d: -f1)
            # Create host directory if it doesn't exist
            mkdir -p "$host_path" 2>/dev/null || true
            run_args="$run_args -v \"$vol_line\""
        fi
    done < <(yaml_get_volumes "$config_file" "$config")

    # Add volumes from templates
    local templates=$(yaml_get_array "$config_file" "templates")
    while IFS= read -r template; do
        [[ -z "$template" ]] && continue
        local template_path="$SCRIPT_DIR/$template"
        if [[ -f "$template_path" ]]; then
            while IFS= read -r vol_line; do
                if [[ -n "$vol_line" ]]; then
                    local host_path=$(echo "$vol_line" | cut -d: -f1)
                    mkdir -p "$host_path" 2>/dev/null || true
                    run_args="$run_args -v \"$vol_line\""
                fi
            done < <(yaml_get_volumes "$template_path" "$config")
        fi
    done <<< "$templates"

    # Add ports
    while IFS= read -r port_line; do
        [[ -n "$port_line" ]] && run_args="$run_args -p $port_line"
    done < <(yaml_get_ports "$config_file")

    # Create shared directories
    mkdir -p "$SHARED_DIR/$config" 2>/dev/null || true
    mkdir -p "$CIDS_DIR" 2>/dev/null || true

    # Run container
    info "Creating container..."
    debug "docker run $run_args $base_image"
    eval "\"$docker_path\" run $run_args $base_image"

    # Wait for container to start
    sleep 2

    if ! container_running "$container_name"; then
        error "Container failed to start"
        "$docker_path" logs "$container_name"
        exit 1
    fi

    # Run provisioning
    info "Running provisioning..."
    run_provisioning "$config_file" "$container_name"

    # Reload supervisor to pick up new service configs (mysql, redis)
    info "Reloading supervisor..."
    "$docker_path" exec "$container_name" supervisorctl reread
    "$docker_path" exec "$container_name" supervisorctl update

    # Wait for services to start and show status
    info "Waiting for services to start..."
    sleep 10
    "$docker_path" exec "$container_name" supervisorctl status

    # Run boot.d scripts now that provisioning has created them
    info "Running boot scripts..."
    "$docker_path" exec "$container_name" bash -c '
        if [ -d /etc/boot.d ]; then
            run-parts --verbose /etc/boot.d
        fi
    '

    # Save container ID
    local container_id=$("$docker_path" container inspect --format '{{.Id}}' "$container_name")
    echo "$container_id" > "$CIDS_DIR/$config.cid"

    success "Bootstrap completed!"
    info "Container '$container_name' is now running"

    # Show access URL if available
    local app_url=$(yaml_get "$config_file" "env.APP_URL" "")
    [[ -n "$app_url" ]] && info "Access your site at: $app_url"
}

run_provisioning() {
    local config_file="$1"
    local container_name="$2"

    # Get templates and merge them
    local templates=$(yaml_get_array "$config_file" "templates")

    # Process each template
    while IFS= read -r template; do
        [[ -z "$template" ]] && continue
        local template_path="$SCRIPT_DIR/$template"

        if [[ -f "$template_path" ]]; then
            debug "Processing template: $template"
            process_template "$template_path" "$container_name" "$config_file"
        else
            warning "Template not found: $template_path"
        fi
    done <<< "$templates"

    # Process run steps from main config
    process_run_steps "$config_file" "$container_name"
}

process_template() {
    local template_file="$1"
    local container_name="$2"
    local config_file="$3"

    # Extract and execute run steps from template, with params from both files
    process_run_steps "$template_file" "$container_name" "$config_file"
}

process_run_steps() {
    local yaml_file="$1"
    local container_name="$2"
    local config_file="${3:-}"

    # Use PHP to extract and execute run steps with variable substitution
    # Pass both the template/yaml file and the config file for param merging
    local php_code='
        $yaml = yaml_parse(file_get_contents("php://stdin"));
        $run = $yaml["run"] ?? [];

        // Get params from template
        $params = $yaml["params"] ?? [];

        // Merge params from config file if provided (config overrides template)
        $configFile = getenv("CONFIG_FILE");
        if ($configFile && file_exists($configFile)) {
            $configYaml = yaml_parse(file_get_contents($configFile));
            $configParams = $configYaml["params"] ?? [];
            $params = array_merge($params, $configParams);
        }

        // Function to substitute variables in a string
        function substituteVars($str, $params) {
            // Sort keys by length (longest first) to avoid partial replacements
            // e.g., $redis_maxmemory_policy must be replaced before $redis_maxmemory
            $keys = array_keys($params);
            usort($keys, function($a, $b) { return strlen($b) - strlen($a); });

            foreach ($keys as $key) {
                $value = $params[$key];
                if (is_scalar($value)) {
                    // Handle strings, integers, floats, and booleans
                    $str = str_replace("\$" . $key, (string)$value, $str);
                }
            }
            return $str;
        }

        foreach ($run as $step) {
            if (isset($step["exec"])) {
                $exec = $step["exec"];
                if (is_string($exec)) {
                    $cmd = str_replace("\n", "\\n", substituteVars($exec, $params));
                    echo "CMD:" . $cmd . "\n";
                } elseif (is_array($exec)) {
                    $cd = substituteVars($exec["cd"] ?? "", $params);
                    $cmds = $exec["cmd"] ?? $exec["command"] ?? [];
                    if (is_string($cmds)) $cmds = [$cmds];

                    foreach ($cmds as $cmd) {
                        $cmd = substituteVars($cmd, $params);
                        if ($cd) {
                            $fullCmd = "cd " . $cd . " && " . $cmd;
                        } else {
                            $fullCmd = $cmd;
                        }
                        // Escape newlines so command stays on one line
                        echo "CMD:" . str_replace("\n", "\\n", $fullCmd) . "\n";
                    }
                }
            } elseif (isset($step["file"])) {
                $file = $step["file"];
                $path = substituteVars($file["path"] ?? "", $params);
                $contents = substituteVars($file["contents"] ?? "", $params);
                $chmod = $file["chmod"] ?? "";
                if ($path) {
                    echo "FILE:" . $path . "\n";
                    echo "CONTENTS:" . base64_encode($contents) . "\n";
                    if ($chmod) echo "CHMOD:" . $chmod . "\n";
                    echo "ENDFILE\n";
                }
            }
        }
    '

    # Mount the config file into the container if provided, so PHP can read params from it
    local mount_args=""
    local config_env=""
    if [[ -n "$config_file" && -f "$config_file" ]]; then
        mount_args="-v \"$config_file:/tmp/config.yml:ro\""
        config_env="-e CONFIG_FILE=/tmp/config.yml"
    fi

    local output=$(cat "$yaml_file" | eval "\"$docker_path\" run --rm -i -a stdin -a stdout $mount_args $config_env \"$DEFAULT_IMAGE\" php -r '$php_code'" 2>/dev/null)

    local current_file=""
    local current_contents=""
    local current_chmod=""

    while IFS= read -r line; do
        if [[ "$line" == CMD:* ]]; then
            local escaped="${line#CMD:}"
            # Unescape newlines
            local cmd=$(echo -e "$escaped")
            debug "Executing: ${cmd:0:80}..."
            "$docker_path" exec "$container_name" bash -c "$cmd" || echo "Command failed: ${cmd:0:80}..."
        elif [[ "$line" == FILE:* ]]; then
            current_file="${line#FILE:}"
        elif [[ "$line" == CONTENTS:* ]]; then
            current_contents="${line#CONTENTS:}"
        elif [[ "$line" == CHMOD:* ]]; then
            current_chmod="${line#CHMOD:}"
        elif [[ "$line" == "ENDFILE" ]]; then
            if [[ -n "$current_file" && -n "$current_contents" ]]; then
                debug "Creating file: $current_file"
                # Create directory
                "$docker_path" exec "$container_name" mkdir -p "$(dirname "$current_file")" 2>/dev/null || true
                # Write file using base64
                echo "$current_contents" | "$docker_path" exec -i "$container_name" bash -c "base64 -d > '$current_file'"
                # Set chmod if specified
                [[ -n "$current_chmod" ]] && "$docker_path" exec "$container_name" chmod "$current_chmod" "$current_file" 2>/dev/null || true
            fi
            current_file=""
            current_contents=""
            current_chmod=""
        fi
    done <<< "$output"
}

cmd_rebuild() {
    local config="$1"
    [[ -z "$config" ]] && fatal "Usage: ./launcher rebuild <config>"

    info "Rebuilding container..."
    cmd_destroy "$config"
    cmd_bootstrap "$config"
}

cmd_run() {
    local config="$1"
    [[ -z "$config" ]] && fatal "Usage: ./launcher run <config> <command...>"

    local container_name=$(get_container_name "$config")
    shift

    if ! container_running "$container_name"; then
        fatal "Container '$container_name' is not running"
    fi

    "$docker_path" exec -it "$container_name" "$@"
}

cmd_artisan() {
    local config="$1"
    [[ -z "$config" ]] && fatal "Usage: ./launcher artisan <config> <command...>"

    local container_name=$(get_container_name "$config")
    shift

    if ! container_running "$container_name"; then
        fatal "Container '$container_name' is not running"
    fi

    "$docker_path" exec -it "$container_name" sudo -u october php /var/www/october/artisan "$@"
}

cmd_cleanup() {
    info "Cleaning up stopped October containers..."

    local cleaned=0
    for container in $("$docker_path" ps -a --format '{{.Names}}' | grep '^october_'); do
        if ! container_running "$container"; then
            info "Removing: $container"
            "$docker_path" rm "$container"
            ((cleaned++))
        fi
    done

    if [[ $cleaned -gt 0 ]]; then
        success "Cleaned up $cleaned container(s)"
    else
        info "No containers to clean up"
    fi
}

cmd_start_cmd() {
    local config="$1"
    [[ -z "$config" ]] && fatal "Usage: ./launcher start-cmd <config>"

    local config_file=$(get_config_file "$config")
    local container_name=$(get_container_name "$config")
    local base_image=$(yaml_get "$config_file" "base_image" "$DEFAULT_IMAGE")

    echo -n "docker run -d --restart unless-stopped --name $container_name"

    # Add environment variables
    while IFS= read -r env_line; do
        [[ -n "$env_line" ]] && echo -n " -e \"$env_line\""
    done < <(yaml_get_env "$config_file")

    # Add volumes
    while IFS= read -r vol_line; do
        [[ -n "$vol_line" ]] && echo -n " -v \"$vol_line\""
    done < <(yaml_get_volumes "$config_file" "$config")

    # Add ports
    while IFS= read -r port_line; do
        [[ -n "$port_line" ]] && echo -n " -p $port_line"
    done < <(yaml_get_ports "$config_file")

    echo " $base_image"
}

cmd_version() {
    echo "October Docker Launcher v$VERSION"
}

cmd_help() {
    cat <<EOF
October Docker Launcher v$VERSION

Usage: ./launcher <command> <config> [options]

Commands:
  start <config>              Start an existing container
  stop <config>               Stop a running container
  restart <config>            Restart a container
  destroy <config>            Stop and remove a container
  enter <config>              Open a shell in the container
  logs <config> [-f]          View container logs (-f to follow)
  bootstrap <config>          Create and provision a new container
  rebuild <config>            Destroy and rebuild a container
  run <config> <cmd>          Run a command in the container
  artisan <config> <cmd>      Run an artisan command
  cleanup                     Remove stopped October containers
  start-cmd <config>          Show the docker run command
  version                     Show version information
  help                        Show this help message

Environment:
  DEBUG=1                     Enable debug output

Examples:
  ./launcher bootstrap app    Create and start the 'app' container
  ./launcher enter app        Open a shell in 'app' container
  ./launcher logs app -f      Follow logs for 'app' container
  ./launcher artisan app migrate  Run database migrations
  ./launcher rebuild app      Rebuild 'app' from scratch

Configuration:
  Container configs are stored in: containers/<config>.yml
  Sample configs are available in: samples/

Requirements:
  - Docker (that's it!)

EOF
}

##############################################################################
# Main
##############################################################################

# Parse global options
while [[ "$1" == --* ]]; do
    case "$1" in
        --debug)
            DEBUG=1
            shift
            ;;
        *)
            break
            ;;
    esac
done

# Get command
command="${1:-help}"
shift || true

# Execute command
case "$command" in
    start)      cmd_start "$@" ;;
    stop)       cmd_stop "$@" ;;
    restart)    cmd_restart "$@" ;;
    destroy)    cmd_destroy "$@" ;;
    enter)      cmd_enter "$@" ;;
    logs)       cmd_logs "$@" ;;
    bootstrap)  cmd_bootstrap "$@" ;;
    rebuild)    cmd_rebuild "$@" ;;
    run)        cmd_run "$@" ;;
    artisan)    cmd_artisan "$@" ;;
    cleanup)    cmd_cleanup "$@" ;;
    start-cmd)  cmd_start_cmd "$@" ;;
    version|--version|-v)  cmd_version ;;
    help|--help|-h)        cmd_help ;;
    *)
        error "Unknown command: $command"
        info "Run './launcher help' for available commands"
        exit 1
        ;;
esac
