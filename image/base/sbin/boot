#!/bin/bash

# October Docker Boot Script
# Initializes the container and starts supervisord

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Graceful shutdown handler
shutdown() {
    log_info "Received shutdown signal, stopping services..."

    # Stop supervisor gracefully
    if [ -f /var/run/supervisord.pid ]; then
        supervisorctl stop all 2>/dev/null || true
        kill -TERM "$(cat /var/run/supervisord.pid)" 2>/dev/null || true
    fi

    log_info "Shutdown complete"
    exit 0
}

# Set up signal handlers
trap shutdown SIGTERM SIGHUP SIGINT

log_info "Starting October Docker container..."

# Ensure shared directories exist with correct ownership
log_info "Setting up directories..."
mkdir -p /shared/log /shared/uploads /shared/storage /shared/mysql /shared/redis
mkdir -p /var/log/october /var/log/supervisor /run/php /var/run/mysqld

# Set ownership for application directories
chown -R october:www-data /shared/log /shared/uploads /shared/storage 2>/dev/null || true
chown -R october:www-data /var/log/october 2>/dev/null || true

# Set ownership for service data directories (critical for restarts)
chown -R mysql:mysql /shared/mysql /var/run/mysqld 2>/dev/null || true
chown -R redis:redis /shared/redis 2>/dev/null || true
chown -R www-data:www-data /run/php 2>/dev/null || true

# Ensure correct permissions
chmod 755 /shared/mysql /shared/redis 2>/dev/null || true

# Fix October storage permissions (critical for cache, sessions, views)
if [ -d /var/www/october/storage ]; then
    chown -R october:www-data /var/www/october/storage
    chmod -R 775 /var/www/october/storage
fi
if [ -d /var/www/october/bootstrap/cache ]; then
    chown -R october:www-data /var/www/october/bootstrap/cache
    chmod -R 775 /var/www/october/bootstrap/cache
fi

# Note: boot.d scripts are run AFTER supervisor starts services
# This allows database-dependent scripts to run after MySQL is available

# Generate .env from environment if APP_KEY is set
if [ -n "$APP_KEY" ]; then
    log_info "Generating .env from environment variables..."

    cat > /var/www/october/.env <<ENVEOF
APP_NAME="${APP_NAME:-October CMS}"
APP_ENV="${APP_ENV:-production}"
APP_KEY="${APP_KEY}"
APP_DEBUG="${APP_DEBUG:-false}"
APP_URL="${APP_URL:-http://localhost}"

LOG_CHANNEL="${LOG_CHANNEL:-stack}"

DB_CONNECTION="${DB_CONNECTION:-mysql}"
DB_HOST="${DB_HOST:-127.0.0.1}"
DB_PORT="${DB_PORT:-3306}"
DB_DATABASE="${DB_DATABASE:-october}"
DB_USERNAME="${DB_USERNAME:-october}"
DB_PASSWORD="${DB_PASSWORD:-}"

CACHE_DRIVER="${CACHE_DRIVER:-file}"
SESSION_DRIVER="${SESSION_DRIVER:-file}"
QUEUE_CONNECTION="${QUEUE_CONNECTION:-sync}"

REDIS_HOST="${REDIS_HOST:-127.0.0.1}"
REDIS_PORT="${REDIS_PORT:-6379}"

MAIL_MAILER="${MAIL_MAILER:-smtp}"
MAIL_HOST="${MAIL_HOST:-localhost}"
MAIL_PORT="${MAIL_PORT:-587}"
MAIL_USERNAME="${MAIL_USERNAME:-}"
MAIL_PASSWORD="${MAIL_PASSWORD:-}"
MAIL_ENCRYPTION="${MAIL_ENCRYPTION:-tls}"
MAIL_FROM_ADDRESS="${MAIL_FROM_ADDRESS:-noreply@example.com}"
MAIL_FROM_NAME="${MAIL_FROM_NAME:-October CMS}"
ENVEOF

    chown october:www-data /var/www/october/.env
    chmod 640 /var/www/october/.env
fi

# Wait for database if configured
if [ -n "$DB_HOST" ] && [ "$DB_HOST" != "127.0.0.1" ]; then
    log_info "Waiting for database at $DB_HOST:${DB_PORT:-3306}..."

    max_tries=30
    tries=0

    while [ $tries -lt $max_tries ]; do
        if mariadb-admin ping -h "$DB_HOST" -P "${DB_PORT:-3306}" --silent 2>/dev/null; then
            log_info "Database is ready!"
            break
        fi

        tries=$((tries + 1))
        log_warn "Database not ready, attempt $tries/$max_tries..."
        sleep 2
    done

    if [ $tries -eq $max_tries ]; then
        log_error "Could not connect to database after $max_tries attempts"
    fi
fi

# Run migrations if requested
if [ "$RUN_MIGRATIONS" = "true" ] || [ "$RUN_MIGRATIONS" = "1" ]; then
    if [ -f /var/www/october/artisan ]; then
        log_info "Running database migrations..."
        cd /var/www/october
        sudo -u october php artisan october:migrate --force || log_warn "Migration failed or no migrations to run"
    fi
fi

# Clear and cache config for production
if [ "$APP_ENV" = "production" ]; then
    if [ -f /var/www/october/artisan ]; then
        log_info "Optimizing for production..."
        cd /var/www/october
        sudo -u october php artisan config:cache 2>/dev/null || true
        sudo -u october php artisan route:cache 2>/dev/null || true
        sudo -u october php artisan view:cache 2>/dev/null || true
    fi
fi

log_info "Starting supervisord..."

# Start supervisord in background first
/usr/bin/supervisord -c /etc/supervisor/supervisord.conf

# Wait for supervisor to start services
sleep 3

# Run boot.d scripts after services are available
if [ -d /etc/boot.d ]; then
    log_info "Running boot scripts..."
    run-parts --verbose /etc/boot.d || true
fi

log_info "Boot complete, tailing supervisor log..."

# Keep container running by tailing the supervisor log
exec tail -f /var/log/supervisor/supervisord.log
